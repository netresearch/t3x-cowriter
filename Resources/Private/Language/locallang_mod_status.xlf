            </trans-unit>
            <trans-unit id="status.check.model_active" resname="status.check.model_active">
                <source>Model active</source>
            </trans-unit>
            <trans-unit id="status.check.configuration_exists" resname="status.check.configuration_exists">
                <source>Configuration exists</source>
            </trans-unit>
            <trans-unit id="status.check.configuration_active" resname="status.check.configuration_active">
