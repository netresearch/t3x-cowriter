                <source>Check LLM configuration status for the Cowriter extension.</source>
            </trans-unit>
            <trans-unit id="mlang_labels_tablabel" resname="mlang_labels_tablabel">
                <source>Cowriter Setup Status</source>
            </trans-unit>
            <trans-unit id="status.intro" resname="status.intro">
                <source>This page checks whether the LLM configuration required by the Cowriter extension is complete.</source>
            </trans-unit>
            <trans-unit id="status.ok.title" resname="status.ok.title">
                <source>Everything is configured correctly</source>
            </trans-unit>
            <trans-unit id="status.ok.message" resname="status.ok.message">
                <source>All required LLM components are set up. The Cowriter is ready to use.</source>
            </trans-unit>
            <trans-unit id="status.incomplete.title" resname="status.incomplete.title">
                <source>Configuration incomplete</source>
            </trans-unit>
            <trans-unit id="status.incomplete.message" resname="status.incomplete.message">
